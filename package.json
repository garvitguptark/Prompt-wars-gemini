{
  "name": "airwise",
  "version": "1.0.0",
  "description": "Urban Air Quality Assistant: live air data and Gemini turn smog days into a household plan with measurable impact.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95",
    "check": "node --check server.js && for f in src/*.js public/*.js; do node --check \"$f\" || exit 1; done",
    "test:e2e": "playwright test --trace off",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "3.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  }
}
