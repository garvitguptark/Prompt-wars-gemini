# Copy to .env for a local run (.env is never committed). On Cloud Run, deploy.sh sets these from Secret Manager.

# Gemini: an API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ...or Vertex AI through Google Cloud credentials, with no key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Optional: Gemini models to try in order, comma-separated.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Optional: a Google Maps Platform key with the Air Quality API enabled. Without it, air data comes from Open-Meteo.
MAPS_API_KEY=

PORT=8080
